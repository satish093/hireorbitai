{
  "expo": {
    "name": "HireOrbit AI",
    "slug": "hireorbitai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hireorbitai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a8a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hireorbitai.app",
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Attach photos to messages, tasks and work-authorization documents.",
        "NSPhotoLibraryUsageDescription": "Attach images and documents to messages, tasks and resumes.",
        "NSMicrophoneUsageDescription": "Make and receive voice calls with your recruiting team.",
        "NSFaceIDUsageDescription": "Unlock HireOrbit AI with Face ID so your recruiting data stays protected on this device.",
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:hireorbitai.com"]
    },
    "android": {
      "package": "com.hireorbitai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a8a"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "hireorbitai.com" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1e3a8a",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3b82f6"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "_comment": "typedRoutes is OFF. In this npm-workspaces layout the Expo CLI hoists to the repo root while expo-router resolves inside mobile/node_modules, so the CLI's typed-route generator cannot require expo-router/_ctx-shared and crashes Metro on startup. It is a DX nicety (autocomplete on href strings), not a runtime feature — the app is unaffected. Re-enable if the hoisting is ever flattened.",
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
