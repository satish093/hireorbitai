# HireOrbit AI — mobile app environment.
#
# Copy to `.env` and fill in. Expo inlines any var prefixed EXPO_PUBLIC_ into
# the JS bundle at BUILD time — exactly like Vite's VITE_* vars on the web.
# That means:
#   • changing a value requires a fresh build, not just a restart
#   • NOTHING secret may live here (the bundle is shippable and readable)
#
# There is deliberately no API key of any kind in this file. The app
# authenticates the same way the web app does: POST /auth/login → JWT.

# Base URL of the HireOrbit API. No trailing slash.
#   production   https://api.hireorbitai.com
#   single-domain https://hireorbitai.com/api
#   local dev     http://192.168.1.x:4000   ← must be your machine's LAN IP,
#                 NOT localhost: a phone/emulator resolves localhost to itself.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Enables the in-app dev tools surface (role switcher, raw API console).
# Leave unset for any build you hand to a real user.
EXPO_PUBLIC_DEV_TOOLS=false
