{
  "name": "@hireorbitai/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "HireOrbit AI mobile app — React Native + Expo. Second client of the same Express API the web app uses.",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "prebuild": "expo prebuild",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@hireorbitai/shared": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "axios": "^1.7.9",
    "expo": "~52.0.0",
    "expo-application": "~6.0.1",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~13.0.1",
    "expo-file-system": "~18.0.6",
    "expo-image-picker": "~16.0.3",
    "expo-linking": "~7.0.3",
    "expo-local-authentication": "~15.0.1",
    "expo-notifications": "~0.29.11",
    "expo-router": "~4.0.11",
    "expo-screen-capture": "~7.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "typescript": "~5.7.2"
  }
}
