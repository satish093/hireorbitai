{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hireorbitai.com/api",
        "EXPO_PUBLIC_DEV_TOOLS": "true"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hireorbitai.com/api",
        "EXPO_PUBLIC_DEV_TOOLS": "false"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hireorbitai.com/api",
        "EXPO_PUBLIC_DEV_TOOLS": "false"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "../keys/AuthKey_24F7736GTD.p8",
        "ascApiKeyId": "24F7736GTD",
        "ascApiKeyIssuerId": "dcfca5b9-bd3a-4d8c-b979-7ceacd4c93e9",
        "ascAppId": "6804181190"
      }
    }
  }
}
