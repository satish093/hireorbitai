{
  "name": "hireorbitai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "HireOrbit AI — Express + TypeScript API (Node.js 22)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch --import tsx --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "bootstrap:admin": "node --env-file=.env scripts/bootstrap-admin.mjs",
    "seed:mock": "node --env-file=.env scripts/seed-mock-data.mjs",
    "migrate:up": "node --env-file=.env scripts/migrate.mjs up --migrations-dir migrations --migration-file-language sql",
    "migrate:ci": "node scripts/migrate.mjs up --migrations-dir migrations --migration-file-language sql",
    "migrate:down": "node --env-file=.env scripts/migrate.mjs down --migrations-dir migrations --migration-file-language sql --count 1",
    "migrate:create": "node --env-file=.env scripts/migrate.mjs create --migrations-dir migrations --migration-file-language sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@google/generative-ai": "^0.24.0",
    "@hireorbitai/shared": "*",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "groq-sdk": "^1.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.0",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "resend": "^4.0.0",
    "unpdf": "^1.6.2",
    "word-extractor": "^1.0.4",
    "playwright": "^1.49.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "node-pg-migrate": "^8.0.4",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
