# =============================================================================
# PRODUCTION backend env template — copy to `.env` ON THE VPS, fill real values.
#
#     cp backend/.env.production.example backend/.env
#
# !! COMMITTED FILE — placeholders only, NEVER real secrets. !!
# This is the canonical .env.example for the VPS production deployment.
# See docs/deployment/02-databases.md and 01-vps-cloudpanel.md.
# =============================================================================

# --- Server ---
PORT=4000
NODE_ENV=production
APP_URL=https://hireorbitai.com
CORS_ORIGIN=https://hireorbitai.com
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Database: PRODUCTION (local socket on the VPS, NOT internet-exposed) ---
# Database name MUST contain 'hireorbit_prod' or the DB guard (DB_GUARD) will
# refuse to boot in production. Create it per docs/deployment/02-databases.md.
DATABASE_URL=postgres://hireorbit_prod_user:CHANGE_ME@127.0.0.1:5432/hireorbit_prod
DATABASE_SSL=disable
# 'enforce' = hard-exit if NODE_ENV and DATABASE_URL disagree about environment.
DB_GUARD=enforce

# --- Filesystem storage (persistent disk on the VPS) ---
UPLOADS_DIR=/var/lib/hireorbitai/uploads
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
STORAGE_URL_SECRET=REPLACE_WITH_RANDOM_48_BYTES_BASE64

# --- Auth tokens ---
JWT_SECRET=REPLACE_WITH_RANDOM_48_BYTES_BASE64
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_SECRET=REPLACE_WITH_RANDOM_48_BYTES_BASE64

# --- AI generation (subscription = Claude CLI on the VPS, no per-token billing) ---
TRAINING_AI_PROVIDER=subscription
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
TRAINING_CONTENT_MODEL=claude-sonnet-4-6
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CLI_PATH=claude

# --- Email (Brevo) ---
BREVO_API_KEY=xkeysib-REPLACE_ME
BREVO_SENDER_EMAIL=noreply@hireorbitai.com
BREVO_SENDER_NAME=HireOrbit AI

# --- Auth flows ---
FRONTEND_URL=https://hireorbitai.com
INVITATION_EXPIRY_HOURS=72
TEMP_PASSWORD_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_MINUTES=15
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=30

# --- Job ingestion (real keys on prod; see backend/.env.example for all options) ---
JOB_SOURCES_MOCK=false
JSEARCH_API_KEY=REPLACE_ME
JSEARCH_COUNTRY=us
