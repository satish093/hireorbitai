# =============================================================================
# !! THIS FILE IS COMMITTED. NEVER PASTE REAL SECRETS HERE. !!
#
# Real keys belong in `.env` (in this same directory) which is gitignored.
# Treat any value already pasted into this file historically as PUBLIC, and
# rotate the corresponding key in the provider's dashboard immediately.
#
# Copy this file to `.env`, then fill in real values there:
#     cp .env.example .env
# =============================================================================

# --- Server ---
PORT=4000
NODE_ENV=production
# Comma-separate multiple origins if you serve from more than one host.
CORS_ORIGIN=https://hireorbitai.com
APP_URL=https://hireorbitai.com
# Behind Nginx / CloudPanel set TRUST_PROXY=1. Set 0 if Node listens on :443 directly.
TRUST_PROXY=1

# Global rate limit. Per-IP, sliding window. Auth routes get a stricter limiter.
# NOTE: 3000/15min is intentional — the sidebar polls 3 endpoints every 60s
# (~180/15min/user) so a lower cap 429s normal traffic on shared NAT networks.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
# Per-user AI endpoint cap (per 5 min). Lower this if provider costs spike.
AI_RATE_LIMIT_MAX=30

# --- Database (self-hosted PostgreSQL on the VPS) ---
# CloudPanel creates the role/db for you; copy the connection string from the
# database panel. Use `disable` for the local socket, `require` for a remote
# Postgres with a valid cert, `no-verify` if you really must skip cert checks.
DATABASE_URL=postgres://hireorbitai:CHANGE_ME@127.0.0.1:5432/hireorbitai
DATABASE_SSL=disable

# --- Filesystem storage ---
# Absolute path on the VPS. The Node process must own (read/write) this dir.
# CloudPanel users typically create /home/<site>/uploads.
UPLOADS_DIR=/var/lib/hireorbitai/uploads
# Secret used to HMAC-sign short-lived download URLs. 48 random bytes is plenty:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
STORAGE_URL_SECRET=REPLACE_WITH_RANDOM_48_BYTES_BASE64

# --- Auth tokens (JWT) ---
# Secret used to sign access tokens. Rotate to invalidate every live session.
JWT_SECRET=REPLACE_WITH_RANDOM_48_BYTES_BASE64
# Access-token TTL (default 1h). Refresh tokens are stored hashed in
# public.auth_sessions and live for JWT_REFRESH_TTL_SECONDS (default 30d).
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Groq (free tier — resume tailoring + job copilot) ---
# Resume scoring, parsing, and job matching are now fully rule-based (no API key needed).
# Tailoring ("Fix My Resume") and job copilot Q&A use Groq's free tier:
#   14,400 req/day · 500K tokens/day · $0 — no credit card required.
# Get a key at console.groq.com → API Keys → Create API Key.
GROQ_API_KEY=gsk_REPLACE_ME

# --- Google Gemini (free tier — scoring, analysis, large-context tasks) ---
# 15 req/min · 1M tokens/day · $0 — no credit card required.
# Get a key at aistudio.google.com → Get API key.
# Used as fallback 2 (after Groq) for generation tasks and as primary for
# scoring/analysis tasks when configured.
#GEMINI_API_KEY=AIza_REPLACE_ME
GEMINI_MODEL=gemini-2.0-flash
# Hard stop before the 1M/day free-tier cap. Once this is hit the process
# falls back to the next provider (Anthropic) for the remainder of the day.
# Reset is at UTC midnight. Lower this further if you want more headroom.
GEMINI_DAILY_TOKEN_LIMIT=950000

# --- Anthropic / AI generation ---
# TRAINING_AI_PROVIDER: 'api' (default), 'oauth', or 'stub'.
#   api   — Anthropic Messages API, billed per token. Requires ANTHROPIC_API_KEY.
#   oauth — Claude.ai subscription OAuth token. Requires ANTHROPIC_OAUTH_TOKEN.
#           Usage counts against your Claude.ai Pro/Team plan quota (no per-token billing).
#           Get token: console.anthropic.com → OAuth → create token.
#   stub  — never call a model; generators return editable placeholder content.
TRAINING_AI_PROVIDER=api
# Required when TRAINING_AI_PROVIDER=api. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Required when TRAINING_AI_PROVIDER=oauth. Claude.ai subscription OAuth access token.
#ANTHROPIC_OAUTH_TOKEN=claude-REPLACE_ME
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Heavier model for long-form lesson/capstone generation.
# NOTE: when TRAINING_AI_PROVIDER=oauth (Claude subscription token), only haiku is
# available via the API — sonnet returns 429. Keep both set to haiku for oauth mode.
TRAINING_CONTENT_MODEL=claude-haiku-4-5-20251001
# --- Token-cost controls (API provider) ---
# Free-text inputs (resume bodies, job descriptions) are clipped to this many
# characters before being sent to the model — input tokens are the dominant API
# cost. ~6000 chars ≈ 1500 tokens. Lower this for cheaper calls (some fidelity
# loss on very long resumes/JDs); raise for max fidelity.
AI_MAX_INPUT_CHARS=6000
# Per-job description budget in the batch job matcher (the recommended feed
# sends many jobs in one call). Title + required_skills carry most of the
# matching signal, so descriptions are clipped hard. Lower = much cheaper feed.
AI_MAX_JOB_DESC_CHARS=600

# --- Email (Brevo only) ---
# Every transactional email — invitations, welcome+temp password, password
# reset, password changed, account locked — is sent via Brevo's v3 REST API.
# No third-party recovery / invite emails, no Resend, no SendGrid.
#   1. Sign up at brevo.com
#   2. Authenticate hireorbitai.com (Senders & Domains → Authenticate)
#   3. SMTP & API → API Keys → Generate (gives an `xkeysib-…` key)
BREVO_API_KEY=xkeysib-REPLACE_ME
BREVO_SENDER_EMAIL=noreply@hireorbitai.com
BREVO_SENDER_NAME="HireOrbit AI"

# --- Auth flows ---
FRONTEND_URL=https://hireorbitai.com
TEMP_PASSWORD_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_MINUTES=15
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=30
# Used for signed cookies if/when needed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
COOKIE_SECRET=REPLACE_WITH_RANDOM_48_BYTES_BASE64

# --- Job ingestion (optional aggregator keys) ---
#
# Test mode: set JOB_SOURCES_MOCK=true to make the LinkedIn / JSearch /
# Adzuna drivers return synthetic data instead of hitting the real APIs.
# Lets you verify Plan B end-to-end (migration → scheduler → upsert →
# frontend) without spending a cent. Mock rows are tagged with external_id
# starting `MOCK-` for easy cleanup:
#   DELETE FROM public.jobs WHERE external_id LIKE 'MOCK-%';
# Default OFF. Turn it back to false (or unset) for real ingestion.
JOB_SOURCES_MOCK=false

# Sign up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and
# subscribe to the free Basic plan (200 req/mo). Then add the key here.
JSEARCH_API_KEY=REPLACE_ME
JSEARCH_COUNTRY=us
# Comma- or pipe-separated search queries; each gets its own paginated pull.
JSEARCH_QUERIES="software engineer in united states|data engineer in united states|full stack developer in united states"


# --- LinkedIn via Fantastic Jobs (RapidAPI) ---
# Pulls active LinkedIn postings. RAPIDAPI_KEY is reused for the LinkedIn,
# JSearch, and any other RapidAPI-hosted driver. Falls back to JSEARCH_API_KEY
# if RAPIDAPI_KEY is empty (typically the same RapidAPI account).
RAPIDAPI_KEY=
LINKEDIN_TITLES="Software Engineer|Data Engineer|Full Stack Developer"
LINKEDIN_LOCATIONS="United States"
LINKEDIN_WINDOW=24h

# --- Monster (RapidAPI) ---
# Reuses RAPIDAPI_KEY. Slug format on source_companies rows:
#   "<keyword>|<location>|<countryCode>"
MONSTER_KEYWORDS="software engineer|data engineer|full stack developer"
MONSTER_LOCATION="United States"
MONSTER_COUNTRY_CODE=en_us
MONSTER_MAX_ROWS=50

# --- Glassdoor Real-Time (RapidAPI) ---
# Used for interview prep, not job ingestion. Reuses RAPIDAPI_KEY.
GLASSDOOR_HOST=glassdoor-real-time.p.rapidapi.com

# --- Auto-match-and-notify ---
# After each sync, newly-pulled jobs are scored against every active consultant.
# Any match >= this threshold (0-100) DMs the consultant's recruiter from the
# first SUPER_ADMIN/CEO user. Set to 100 to effectively disable.
MATCH_NOTIFY_THRESHOLD=85

# --- Auth ---
INVITATION_EXPIRY_HOURS=72

# --- Off-site backups (Mega) — read by scripts/ops.sh, not the app ---
# Mega gives 20 GB free with no credit card. Set these two and every deploy
# auto-wires rclone + the weekly backup cron (scripts/update.sh calls
# `ops.sh ensure`). Leave blank to skip auto-setup. Use a dedicated mega.nz
# account for backups, not your personal one.
# MEGA_EMAIL=
# MEGA_PASSWORD=

# --- Optional: runtime default-admin bootstrap ---
# The canonical path is `npm run bootstrap:admin`. Set ENABLE_DEFAULT_ADMIN=true
# (and supply DEFAULT_ADMIN_EMAIL + DEFAULT_ADMIN_PASSWORD) only if you want
# the API process itself to provision the first admin on boot (e.g. ephemeral
# CI environments). Booting without both vars set is a no-op — there are no
# fallback credentials baked into the source.
#
# DEFAULT_ADMIN_PASSWORD must be >= 12 characters. Whatever you supply gets
# armed with must_change_password=true and dies the moment the first human
# signs in.
#
# ENABLE_DEFAULT_ADMIN=true
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_ADMIN_NAME=
# DEFAULT_ADMIN_ROLE=SUPER_ADMIN
# DEFAULT_ADMIN_RESET=false
