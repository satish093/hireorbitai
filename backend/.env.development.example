# =============================================================================
# DEVELOPMENT backend env template.
#
# Two ways this gets used:
#   1. LOCAL (Windows / VS Code): copy to `.env`, run `npm --prefix backend run dev`.
#        cp backend/.env.development.example backend/.env
#   2. RENDER (free dev hosting): these same keys are set in the Render
#        dashboard (Environment tab) — see docs/deployment/03-render-dev-hosting.md.
#
# !! COMMITTED FILE — placeholders only, NEVER real secrets. !!
# =============================================================================

# --- Server ---
PORT=4000
# MUST be 'development' (not 'production') so the DB guard treats the dev DB as
# legal. Render injects PORT itself; leave PORT here for local runs only.
NODE_ENV=development
# Local: the Vite dev server origin. Render: the static-site URL (*.onrender.com).
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0
# Looser limits for local poking.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000

# --- Database: DEVELOPMENT (Neon free tier — separate server from prod) ---
# Database name MUST contain 'hireorbit_dev' (or host neon.tech) or DB_GUARD
# will reject a prod URL here. Get this from the Neon dashboard.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/hireorbit_dev?sslmode=require
# Neon requires TLS.
DATABASE_SSL=require
DB_GUARD=enforce

# --- Filesystem storage ---
# Local: a folder in your repo (gitignored). Render free: /tmp (ephemeral).
UPLOADS_DIR=./.uploads-dev
STORAGE_URL_SECRET=dev-only-not-secret-replace-with-32+-random-characters

# --- Auth tokens (dev-only throwaway secrets) ---
JWT_SECRET=dev-only-not-secret-replace-with-32+-random-characters
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
COOKIE_SECRET=dev-only-not-secret-replace-with-32+-random-characters

# --- AI generation: stub on dev (no Claude CLI / no API spend) ---
TRAINING_AI_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
TRAINING_CONTENT_MODEL=claude-sonnet-4-6

# --- Email (Brevo) — use a real key OR leave blank; email paths throw lazily ---
BREVO_API_KEY=xkeysib-REPLACE_ME_OR_LEAVE_FOR_DEV
BREVO_SENDER_EMAIL=noreply@hireorbitai.com
BREVO_SENDER_NAME=HireOrbit AI (dev)

# --- Auth flows ---
FRONTEND_URL=http://localhost:5173
INVITATION_EXPIRY_HOURS=72
TEMP_PASSWORD_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_MINUTES=15
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=30

# --- Job ingestion: mock mode on dev = zero API spend ---
JOB_SOURCES_MOCK=true
