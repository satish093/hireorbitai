# Frontend DEV env template. Copy to `frontend/.env.development` for local Vite
# dev (`npm --prefix frontend run dev`), which runs in "development" mode.
#
#     cp frontend/.env.development.example frontend/.env.development
#
# VITE_* vars are baked into the bundle at BUILD time. On Render the dev value
# is set in the static-site dashboard, not from this file.
# !! COMMITTED — placeholders only. !!

# Local backend API. Note the app expects the URL to end with /api.
VITE_API_URL=http://localhost:4000/api
