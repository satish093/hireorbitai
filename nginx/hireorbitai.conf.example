# =============================================================================
# HireOrbit AI — Nginx site config (CloudPanel-compatible)
#
# Drop the location blocks below INSIDE the existing HTTPS `server { … }` block
# that CloudPanel generated for the site. Do NOT replace the file — CloudPanel
# auto-regenerates it on cert renewal and would clobber a hand-written version.
#
# Single-domain deployment (hireorbitai.com serves both UI and /api):
#   - Static UI:    served from $ROOT (the Vite dist/)
#   - Backend:      proxied at /api/  to 127.0.0.1:4000
#
# Split-domain deployment:
#   - hireorbitai.com         → static UI only (this file's `location /` blocks)
#   - api.hireorbitai.com     → backend only (use the proxy block as the whole site root)
# =============================================================================

# --- Static frontend ---------------------------------------------------------
# Long-cache hashed assets; never-cache the entry HTML so the new bundle is
# fetched on the next reload after a deploy.
location / {
  root  /home/hireorbitai/htdocs/hireorbitai.com;
  try_files $uri /index.html;
}

location ~* \.(?:js|css|woff2?|ttf|png|jpe?g|gif|svg|webp|ico|mp4|webm)$ {
  root    /home/hireorbitai/htdocs/hireorbitai.com;
  expires 1y;
  add_header Cache-Control "public, max-age=31536000, immutable";
  access_log off;
}

location = /index.html {
  root    /home/hireorbitai/htdocs/hireorbitai.com;
  add_header Cache-Control "no-cache, no-store, must-revalidate";
}

# --- Backend reverse proxy ---------------------------------------------------
location /api/ {
  proxy_pass         http://127.0.0.1:4000/;
  proxy_http_version 1.1;
  proxy_set_header   Host $host;
  proxy_set_header   X-Real-IP $remote_addr;
  proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header   X-Forwarded-Proto $scheme;
  proxy_read_timeout 65s;
  proxy_send_timeout 65s;

  # Resume / task attachment uploads. Keep in sync with the multer limits in
  # backend/src/middleware/upload.ts (10 MB resumes, 15 MB attachments).
  client_max_body_size 20m;
}

# --- Security headers --------------------------------------------------------
# CloudPanel usually emits these from its own template. If yours doesn't, add
# them inside the same server { } block.
add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
add_header X-Content-Type-Options    "nosniff" always;
add_header X-Frame-Options           "DENY" always;
add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
add_header Permissions-Policy        "camera=(), microphone=(), geolocation=()" always;

# --- ACME challenge (Let's Encrypt) ------------------------------------------
# CloudPanel handles this — do NOT add a competing block. Listed here only as
# a reminder: if you ever hand-roll the vhost, leave /.well-known/acme-challenge/
# untouched so renewal keeps working.
