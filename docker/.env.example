# Copy to docker/.env and fill in. Used ONLY by docker/docker-compose.yml.
# (The runtime container env is sourced from this file — keep it gitignored.)

# --- Postgres ---
POSTGRES_USER=hireorbitai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hireorbitai

# --- API ---
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Generate each of these with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
STORAGE_URL_SECRET=REPLACE_WITH_48_RANDOM_BYTES_BASE64
JWT_SECRET=REPLACE_WITH_48_RANDOM_BYTES_BASE64
COOKIE_SECRET=REPLACE_WITH_48_RANDOM_BYTES_BASE64

# --- External services ---
BREVO_API_KEY=xkeysib-REPLACE_ME
BREVO_SENDER_EMAIL=noreply@hireorbitai.com
BREVO_SENDER_NAME=HireOrbit AI

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Frontend build-time (only consumed if you enable the `frontend` service) ---
VITE_API_URL=http://localhost:4000
