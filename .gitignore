node_modules/
dist/

# Env files — never commit secrets. .env.example is allowed to be tracked
# but it must contain placeholders only (e.g. `BREVO_API_KEY=xkeysib-...`),
# never real keys. The negation rule below makes that explicit.
.env
.env.*
!.env.example
# Per-environment templates (placeholders only, never real secrets):
#   backend/.env.development.example, backend/.env.production.example, etc.
!.env.*.example

.env.local
.DS_Store
*.log
.vite/

# Claude Code config — commit team-shared files under .claude/ but exclude
# personal overrides and per-agent memory the team doesn't share.
.claude/settings.local.json
.claude/projects/
.claude/cache/

# PM2 + Node 22 build artifacts
.pm2/
*.tsbuildinfo

# Husky internals (the templates we commit live at .husky/<hook>; the
# `.husky/_` directory is created by `husky` at install time).
.husky/_/

# Backups (local + production stamped dirs from scripts/backup.sh)
backups/
~backups/

# IDE
.idea/
.vscode/

# Coverage
coverage/

# Playwright (UI smoke suite) — generated artifacts, never committed
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.playwright/
test-results/

# OWASP ZAP baseline scan output (scripts/zap-baseline.ps1)
zap-report/
